--- a/pwelch.m
+++ b/pwelch.m
@@ -347,6 +347,23 @@
 
     ## IndyMAT: default to the package's MATLAB sample-overlap convention.
     compatib = 3;
+  endif
+  ## IndyMAT: MATLAB default windows cannot be formed from <=8 samples.
+  if (nargin >= 1 && compatib == 3 && isnumeric (x) && isvector (x) && ! isempty (x) && numel (x) <= 8 && (nargin == 1 || isempty (varargin{1})))
+    error ('signal:welchparse:NotEnoughSamplesForDefaultSettings', ...
+           'pwelch: the input record needs more than eight samples for the default window and overlap');
+  endif
+  ## Explicit frequency vectors request a two-sided Welch estimate; scalar
+  ## FFT lengths, compatibility controls and extended options retain wave 15.
+  if ((nargin == 4 || nargin == 5) && compatib == 3 && isnumeric (varargin{3}) && isvector (varargin{3}) && numel (varargin{3}) > 1)
+    [power, freq] = __mf_pwelch_frequency__ (x, varargin{:});
+    if (nargout == 0)
+      plot (freq, 10*log10(power)); xlabel ('Frequency'); ylabel ('Power density');
+    else
+      varargout{1} = power;
+      if (nargout > 1), varargout{2} = freq; endif
+    endif
+    return;
   endif
   if ( nargin <= 0 )
     error( 'pwelch: Need at least 1 arg. Use "help pwelch".' );
