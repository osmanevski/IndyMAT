 ## answers for it and checks nothing itself.
 %!test
 %! ## The suite for this class is inst/tests/string.m-tst.
+
+## IndyMAT mixed-dispatch bridge: remove all string objects before redispatch.
+## Missing later arguments are unsupported rather than silently becoming ''.
+function args = indymat_text_args (args, name)
+  for k = 1:numel (args)
+    if (isa (args{k}, 'string'))
+      if (any (ismissing (args{k})(:)))
+        error ('%s: missing string arguments are not supported', name);
+      endif
+      if (isscalar (args{k}))
+        args{k} = char (args{k});
+      else
+        args{k} = cellstr (args{k});
+      endif
+    endif
+  endfor
+endfunction
